    "dropdown.background": "#DCD6C3",
    "quickInput.background": "#D3CCB8",
    "widget.shadow": "#2D2B2633",
    "editorWidget.background": "#D3CCB8",
    "scrollbarSlider.background": "#4A463D33",
    "scrollbarSlider.hoverBackground": "#4A463D55",
    "badge.background": "#C8553D",
    "badge.foreground": "#D3CCB8",
    "gitDecoration.modifiedResourceForeground": "#A07A2E",
    "gitDecoration.untrackedResourceForeground": "#5E7D52",
    "gitDecoration.deletedResourceForeground": "#C8553D",
    "breadcrumb.background": "#DCD6C3",
    "breadcrumb.foreground": "#7A7462",
    "minimap.background": "#DCD6C3"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7A7462",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "storage.type"
      ],
      "settings": {
        "foreground": "#C8553D"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#5E7D52"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#86631C"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#4F6B78"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#8A5A6E"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#2D2B26"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#C8553D"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#4E7A72"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#C8553D",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    }
  ]
}