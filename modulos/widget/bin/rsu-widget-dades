#!/usr/bin/env python3
"""Dades per al widget RSU · Vigilància.
Llegeix ~/.config/rsu-widget/config.json, demana els preus a Yahoo Finance
i busca informes RSU recents a la carpeta indicada. Escriu JSON per stdout.
Ús:  rsu-widget-dades            (dades reals)
     rsu-widget-dades --demo     (dades d'exemple, per provar el widget)
Només fa servir la biblioteca estàndard de Python."""
import json, os, re, sys, time, glob, subprocess, urllib.request, urllib.error
from http.cookies import SimpleCookie
from datetime import datetime

CFG = os.path.expanduser("~/.config/rsu-widget/config.json")
CACHE = os.path.expanduser("~/.cache/rsu-widget/ultim.json")
SESSIO = os.path.expanduser("~/.cache/rsu-widget/sessio")
DEFAULT = {"tickers": ["SPY", "NVDA", "MSFT", "ASML"],
           "carpeta_informes": "~/RSU/informes",
           "hores_informes_nous": 24}

def config():
    try:
        with open(CFG) as f:
            return {**DEFAULT, **json.load(f)}
    except FileNotFoundError:
        os.makedirs(os.path.dirname(CFG), exist_ok=True)
        with open(CFG, "w") as f:
            json.dump(DEFAULT, f, indent=2)
        return DEFAULT

def preu(t):
    url = f"https://query1.finance.yahoo.com/v8/finance/chart/{t}?range=1d&interval=1d"
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=8) as r:
        m = json.load(r)["chart"]["result"][0]["meta"]
    p = float(m["regularMarketPrice"])
    prev = float(m.get("chartPreviousClose") or m.get("previousClose") or p)
    return {"s": t, "p": round(p, 2), "c": round((p / prev - 1) * 100, 2) if prev else 0.0}

# ---- Cartera RSU (RSU Terminal) --------------------------------------------
# Credencials al moneder de KDE:  secret-tool store --label="RSU Terminal" service rsu-terminal user EL_TEU_CORREU
def credencials():
    r = subprocess.run(["secret-tool", "search", "service", "rsu-terminal"],
                       capture_output=True, text=True, timeout=15)
    txt = r.stdout + "\n" + r.stderr
    user = re.search(r"attribute\.user\s*=\s*(\S+)", txt)
    pwd = subprocess.run(["secret-tool", "lookup", "service", "rsu-terminal"],
                         capture_output=True, text=True, timeout=15).stdout
    if not user or not pwd:
        raise RuntimeError("sense credencials al moneder")
    return user.group(1), pwd.rstrip("\n")

def login(url):
    email, pwd = credencials()
    req = urllib.request.Request(url + "/api/v1/auth/login", method="POST",
        data=json.dumps({"email": email, "password": pwd, "remember": True}).encode(),
        headers={"Content-Type": "application/json", "User-Agent": "rsu-widget"})
    with urllib.request.urlopen(req, timeout=10) as r:
        c = SimpleCookie()
        for h in r.headers.get_all("Set-Cookie") or []:
            c.load(h)
    tok = c["rsu_session"].value
    os.makedirs(os.path.dirname(SESSIO), exist_ok=True)
    fd = os.open(SESSIO, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(tok)
    return tok

def cartera(cfg):
    c = cfg.get("cartera_rsu")
    if not c:
        return []
    url = c["url"].rstrip("/")
    try:
        tok = open(SESSIO).read().strip()
    except OSError:
        tok = ""
    for _ in range(2):
        if not tok:
            tok = login(url)
        req = urllib.request.Request(url + "/api/v1/cartera/prices",
            headers={"Cookie": "rsu_session=" + tok, "User-Agent": "rsu-widget"})
        try:
            with urllib.request.urlopen(req, timeout=15) as r:
                d = json.load(r)
        except urllib.error.HTTPError as e:
            if e.code in (401, 403):
                tok = ""
                continue
            raise
        out = []
        for q in d.get("prices", []):
            pr, prev = float(q.get("price") or 0), float(q.get("prev") or 0)
            out.append({"s": q["ticker"], "p": round(pr, 2), "c": round((pr / prev - 1) * 100, 2) if prev else 0.0})
        # Barra: els 3 que més pugen i els 2 que més baixen; després la resta, pel moviment
        puja = sorted([x for x in out if x["c"] > 0], key=lambda x: -x["c"])[:3]
        baixa = sorted([x for x in out if x["c"] < 0], key=lambda x: x["c"])[:2]
        resta = sorted([x for x in out if x not in puja + baixa], key=lambda x: -abs(x["c"]))
        return puja + baixa + resta
    raise RuntimeError("RSU Terminal no accepta la sessió")

NOTA = re.compile(r"Trade\s*Grade[^A-F]{0,25}\b([A-F][+\-]{0,2})", re.I)

def nota_de(ruta):
    base = os.path.splitext(ruta)[0]
    for ext in (".md", ".html", ".txt"):
        try:
            with open(base + ext, errors="ignore") as f:
                m = NOTA.search(f.read(200000))
                if m:
                    return m.group(1).upper()
        except OSError:
            pass
    return ""

def informes(cfg):
    carpeta = os.path.expanduser(cfg["carpeta_informes"])
    limit = time.time() - cfg["hores_informes_nous"] * 3600
    vistos, out = set(), []
    for ruta in sorted(glob.glob(os.path.join(carpeta, "**", "*.*"), recursive=True),
                       key=os.path.getmtime, reverse=True):
        if not ruta.lower().endswith((".pdf", ".md", ".html")):
            continue
        mt = os.path.getmtime(ruta)
        if mt < limit:
            break
        m = re.match(r"(?:RSU[_\- ]+)?([A-Za-z][A-Za-z.\-]{0,6})", os.path.splitext(os.path.basename(ruta))[0])
        if not m:
            continue
        t = m.group(1).upper().rstrip("-.")
        if t in vistos:
            continue
        vistos.add(t)
        pdf = os.path.splitext(ruta)[0] + ".pdf"
        obrir = pdf if os.path.exists(pdf) else ruta
        out.append({"t": t, "nota": nota_de(ruta), "hora": datetime.fromtimestamp(mt).strftime("%H:%M"), "ruta": obrir})
    return out[:8]

def demo():
    return {"tickers": [{"s": "SPY", "p": 582.14, "c": 0.42}, {"s": "NVDA", "p": 141.08, "c": -1.10},
                        {"s": "MSFT", "p": 436.70, "c": 0.65}, {"s": "ASML", "p": 702.33, "c": -0.31}],
            "informes": [{"t": "AAPL", "nota": "B+", "hora": "07:42", "ruta": ""}],
            "actualitzat": datetime.now().strftime("%H:%M"), "error": ""}

def main():
    if "--demo" in sys.argv:
        print(json.dumps(demo())); return
    cfg = config()
    res = {"tickers": [], "informes": [], "actualitzat": datetime.now().strftime("%H:%M"), "error": ""}
    errors = 0
    for t in cfg["tickers"]:
        try:
            res["tickers"].append(preu(t))
        except Exception:
            errors += 1
    fixos = {t["s"] for t in res["tickers"]}
    try:
        res["tickers"] += [t for t in cartera(cfg) if t["s"] not in fixos]
    except Exception as e:
        res["avis_cartera"] = str(e)[:120]
    if errors and not res["tickers"]:
        try:
            with open(CACHE) as f:
                vell = json.load(f)
            res["tickers"] = vell.get("tickers", [])
            res["actualitzat"] = vell.get("actualitzat", "")
            res["error"] = "Sense connexió · preus desats"
        except Exception:
            res["error"] = "Sense connexió"
    try:
        res["informes"] = informes(cfg)
    except Exception:
        pass
    if res["tickers"] and not res["error"]:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        with open(CACHE, "w") as f:
            json.dump(res, f)
    print(json.dumps(res, ensure_ascii=False))

if __name__ == "__main__":
    main()
