{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Logo RSU. Para el pino, cambia "logo-rsu.txt" por "logo-pi.txt".
  // Colores con códigos ANSI: 31 = rojo, 39 = color normal del texto, 2 = atenuado.
  // Así se ve bien con el tema claro (Unlord) y el oscuro (Unlord Nit).
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo-rsu.txt",
    "color": { "1": "39", "2": "31", "3": "2" },
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "31", "title": "39" }
  },
  "modules": [
    "title",
    { "type": "custom", "format": "──────────────────────────" },
    { "type": "os",       "key": "SISTEMA " },
    { "type": "kernel",   "key": "KERNEL  " },
    { "type": "de",       "key": "ENTORN  " },
    { "type": "uptime",   "key": "ACTIU   " },
    { "type": "packages", "key": "PAQUETS " },
    { "type": "cpu",      "key": "CPU     " },
    { "type": "gpu",      "key": "GPU     " },
    { "type": "memory",   "key": "MEMÒRIA " },
    { "type": "disk",     "key": "DISC    ", "folders": "/" },
    "break",
    { "type": "custom", "format": "REDISTRIBUTION RESEARCH UNIT" },
    "break",
    { "type": "colors", "symbol": "square" }
  ]
}
