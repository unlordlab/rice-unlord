    def t(x, y, s, size=14, col=None, a="start", ls=2.6):
        return (f'<text x="{x:.1f}" y="{y:.1f}" font-family="Share Tech Mono" font-size="{size}" '
                f'letter-spacing="{ls}" fill="{col or sub}" text-anchor="{a}">{s}</text>')

    def logo(path, x, y, w, col):
        return f'<g transform="translate({x},{y}) scale({w / 2088})"><path d="{path}" fill="{col}" fill-rule="evenodd"/></g>'

    def bands(col):
        o = ""
        for y in (86, H - 86):
            dd = 1 if y < H / 2 else -1
            o += f'<line x1="120" x2="{W - 120}" y1="{y}" y2="{y}" stroke="{col}" stroke-width="1.2" opacity=".55"/>'
            o += f'<line x1="120" x2="{W - 120}" y1="{y + 6 * dd}" y2="{y + 6 * dd}" stroke="{col}" stroke-width=".6" opacity=".35"/>'
            for x in range(128, W - 120, 22):
                tall = round((x - 128) / 22) % 6 == 0
                h = 7 if tall else 3
                o += f'<rect x="{x}" y="{y + 14 * dd - (h if dd < 0 else 0)}" width="3" height="{h}" fill="{col}" opacity="{.5 if tall else .35}"/>'
        return o

    s = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" viewBox="0 0 {W} {H}">',
         '<defs><pattern id="sl" width="4" height="4" patternUnits="userSpaceOnUse"><rect width="4" height="1" fill="#000" opacity=".04"/></pattern>',
