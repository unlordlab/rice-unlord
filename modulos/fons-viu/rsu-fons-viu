def cfg():
    try:
        with open(CFG) as f:
            return {**DEF, **json.load(f)}
    except Exception:
        return DEF


def yahoo(sym, rng="1d", iv="5m"):
    url = f"https://query1.finance.yahoo.com/v8/finance/chart/{urllib.parse.quote(sym)}?range={rng}&interval={iv}"
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.load(r)["chart"]["result"][0]


def dades_reals(c):
    g = yahoo(c["index"])
    m = g["meta"]
    ts = g.get("timestamp") or []
    cl = g["indicators"]["quote"][0]["close"]
    pts = [(t, v) for t, v in zip(ts, cl) if v is not None]
    per = m.get("currentTradingPeriod", {}).get("regular", {})
    ini = per.get("start", pts[0][0] if pts else 0)
    fi = per.get("end", pts[-1][0] if pts else 1)
    if pts and pts[0][0] < ini - 3600:  # dades de la sessió anterior (cap de setmana, festiu)
        ini, fi = pts[0][0], pts[0][0] + 6.5 * 3600
    prev = m.get("chartPreviousClose") or m.get("previousClose")
    preu = m.get("regularMarketPrice", pts[-1][1] if pts else 0)
    vix = yahoo("^VIX", "1d", "1d")["meta"]["regularMarketPrice"]
    ara = time.time()
    return dict(pts=pts, ini=ini, fi=fi, preu=preu, chg=(preu / prev - 1) * 100 if prev else 0,
                vix=vix, obert=ini < ara < fi)


def dades_demo(mood):
    chg, vix, seed, vol, preu = {"calma": (0.42, 14.2, 7, 4, 5821.40),
                                 "tensio": (-1.18, 22.7, 21, 9, 5688.15),
                                 "panic": (-3.85, 36.4, 5, 16, 5532.90)}[mood]
    rnd = random.Random(seed)
    v = [0.0]
    for _ in range(77):
        v.append(v[-1] + (rnd.random() - .5) * vol / 10)
    d = (chg - v[-1]) / 77
    ini = time.time() - 6.4 * 3600
    pts = [(ini + i * 300, preu * (1 + (x + d * i - chg) / 100)) for i, x in enumerate(v)]
    return dict(pts=pts, ini=ini, fi=ini + 6.5 * 3600, preu=preu, chg=chg, vix=vix, obert=True)


def tema():
    try:
        out = subprocess.run(["kreadconfig6", "--file", "kdeglobals", "--group", "General", "--key", "ColorScheme"],
                             capture_output=True, text=True).stdout
        return "fosc" if "Nit" in out else "clar"
    except Exception:
        return "clar"


def svg(d, c, modo):
    p = PAL[modo]
    ink, red, sub, txt = p["ink"], p["red"], p["sub"], p["text"]
    mood = "panic" if d["vix"] >= c["llindar_panic"] else "tensio" if d["vix"] >= c["llindar_tensio"] else "calma"
