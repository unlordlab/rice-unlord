    s.append(bands(red if mood == "panic" else ink))
    for r, o in ((330, .25), (420, .12), (560, .08)):
        s.append(f'<circle cx="1260" cy="520" r="{r}" fill="none" stroke="{ink}" stroke-width="1" opacity="{o}"/>')

    sg = "+" if d["chg"] >= 0 else "−"
