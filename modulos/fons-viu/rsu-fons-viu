    if pts:
        op = pts[0][1]
        rel = [(tt, (v / op - 1) * 100) for tt, v in pts]
        sc = min(95, 150 / max(max(abs(r) for _, r in rel), 0.05))
        span = max(d["fi"] - d["ini"], 1)
        xy = [(x0 + (x1 - x0) * min(max((tt - d["ini"]) / span, 0), 1), yb - r * sc) for tt, r in rel]
        P = " ".join(f"{x:.1f},{y:.1f}" for x, y in xy)
        s.append(f'<line x1="{x0}" x2="{x1}" y1="{yb}" y2="{yb}" stroke="{ink}" stroke-dasharray="4 6" opacity=".45"/>')
        s.append(t(x0 - 14, yb + 4, "OBERTURA", 11, a="end"))
        s.append(f'<polygon points="{x0},{yb} {P} {xy[-1][0]:.1f},{yb}" fill="{red}" opacity="{.16 if mood == "panic" else .08}"/>')
        s.append(f'<polyline points="{P}" fill="none" stroke="{red}" stroke-width="{3 if mood == "panic" else 2}" opacity=".95"/>')
        lx, ly = xy[-1]
        s.append(f'<circle cx="{lx:.1f}" cy="{ly:.1f}" r="6" fill="{red}"/><circle cx="{lx:.1f}" cy="{ly:.1f}" r="16" fill="none" stroke="{red}" opacity=".6"/>')
        s.append(t(lx + 26, ly + 5, pct, 18, red, ls=2))
        for k in range(7):
            tt = d["ini"] + k * 3600
            if tt <= d["fi"]:
                s.append(t(x0 + (x1 - x0) * (tt - d["ini"]) / span, 906, datetime.fromtimestamp(tt).strftime("%H:%M"), 11))

    s.append(logo(EMB, 970, 170, 580, ink))
    s.append(logo(WORD, 145, 520, 520, txt))
    s.append(f'<line x1="182" y1="700" x2="700" y2="700" stroke="{ink}" stroke-width="1.2" opacity=".6"/><rect x="182" y="706" width="40" height="4" fill="{red}"/>')
    s.append(t(182, 742, "REDISTRIBUTION RESEARCH UNIT", 17, txt, ls=3))
    s.append(t(182, 768, "FONS VIU · DADES DEL MERCAT EN TEMPS REAL", 14))

    lab = {"calma": "CALMA", "tensio": "TENSIÓ", "panic": "PÀNIC"}[mood]
    s.append(t(W - 182, 150, c["nom"].upper().replace("&", "&amp;"), 14, a="end"))
    s.append(t(W - 182, 186, f'{d["preu"]:,.2f}', 30, txt, "end", 3))
    s.append(t(W - 182, 214, pct + (" AVUI" if d["obert"] else " · TANCAT"), 15, red, "end"))
    s.append(t(W - 182, 250, f'VIX {d["vix"]:.1f} · {lab}', 14, sub if mood == "calma" else red, "end"))
    peu = ("ACTUALITZAT " + datetime.now().strftime("%H:%M") + " · CADA 15 MIN") if d["obert"] \
        else "ÚLTIMA SESSIÓ " + datetime.fromtimestamp(d["fi"]).strftime("%d/%m")
    s.append(t(W - 182, 274, peu, 11, a="end"))
    if mood == "panic":
        s.append(f'<rect x="182" y="820" width="330" height="40" fill="{red}"/>' + t(198, 846, "ALERTA · VOLATILITAT EXTREMA", 14, p["lt"]))
    else:
        s.append(t(182, 840, "SENSE SOROLL · NOMÉS SENYAL" if mood == "calma" else "ATENCIÓ · EL SOROLL PUJA", 13, txt))
    s.append("</svg>")
    return "".join(s), mood


def main():
    c = cfg()
    os.makedirs(DIR, exist_ok=True)
    cache = os.path.join(DIR, "dades.json")
    if "--demo" in sys.argv:
        i = sys.argv.index("--demo")
        d = dades_demo(sys.argv[i + 1] if len(sys.argv) > i + 1 else "calma")
    else:
        try:
            d = dades_reals(c)
            with open(cache, "w") as f:
                json.dump(d, f)
        except Exception as e:
            try:
                with open(cache) as f:
                    d = json.load(f)
                d["obert"] = False
            except Exception:
                print("Sense dades ni memòria cau:", e, file=sys.stderr)
                sys.exit(1)
    code, mood = svg(d, c, tema())
    sp = os.path.join(DIR, "fons.svg")
    with open(sp, "w") as f:
        f.write(code)
    w, h = c["mida"].split("x")
    # Dos noms alterns: Plasma no refresca el fons si el nom del fitxer no canvia
    estat = os.path.join(DIR, "actual.txt")
    try:
        last = open(estat).read().strip()
    except Exception:
        last = "b"
    nou = "a" if last == "b" else "b"
    png = os.path.join(DIR, f"fons-viu-{nou}.png")
    subprocess.run(["rsvg-convert", "-w", w, "-h", h, "-o", png, sp], check=True)
    if "--nomes-imatge" in sys.argv:
        print(png)
        return
    # No s'esborra mai l'altre fitxer: si Plasma encara no s'ha carregat (en arrencar),
    # el fons configurat ha de continuar existint.
    r = subprocess.run(["plasma-apply-wallpaperimage", png], check=False, capture_output=True)
    if r.returncode == 0:
        with open(estat, "w") as f:
            f.write(nou)
    print(f"{mood} · {d['chg']:+.2f}% · VIX {d['vix']:.1f} → {png}")


if __name__ == "__main__":
    main()
